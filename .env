# Environment
ENVIRONMENT=development

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=management_system
DB_PORT=5434
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5434/management_system

# Redis
REDIS_PORT=6379

# API
API_PORT=8080
JWT_SECRET=your-super-secret-key-change-in-production-please
JWT_EXPIRATION_HOURS=24

# Logging
RUST_LOG=management_system=debug,tower_http=debug,sqlx=debug
