# Environment
ENVIRONMENT=development

# Database (Different from asset-management)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=management_system
DB_PORT=5436

# Redis
REDIS_PORT=6382

# Connection Strings (Required for cargo run)
DATABASE_URL=postgres://postgres:postgres@localhost:5436/management_system
REDIS_URL=redis://localhost:6382

# API (Different port from asset-management)
API_PORT=8082
JWT_SECRET=management-system-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24

# Logging
RUST_LOG=management_system=debug,tower_http=debug
