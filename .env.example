# Environment (development | staging | production)
ENVIRONMENT=development

# Database Configuration
DB_USER=postgres
DB_PASSWORD=change_this_password
DB_NAME=erpqu_management_system
DB_PORT=5432
DATABASE_URL=postgres://postgres:change_this_password@localhost:5432/erpqu_management_system

# Redis Cache
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# API Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# JWT Authentication (MUST be a strong secret >= 32 characters in production)
JWT_SECRET=change-this-jwt-secret-in-production-min-32-chars
JWT_EXPIRATION_HOURS=24

# Registration & Security Policies
ALLOW_PUBLIC_REGISTRATION=false
ALLOW_DEV_TEST_ROUTES=false

# SMTP Mailer (Optional)
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Logging
RUST_LOG=management_system=info,tower_http=info
