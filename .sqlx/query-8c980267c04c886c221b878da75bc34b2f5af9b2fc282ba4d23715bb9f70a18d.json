  "query": "\n            UPDATE asset_tax_renewals\n            SET invoice_id = $1, \n                status = 'INVOICED', \n                notes = COALESCE($2, notes),\n                updated_at = NOW()\n            WHERE id = $3\n            RETURNING id, asset_id, document_type, current_expiry, renewal_cost, status, invoice_id, notes, payment_destination, invoice_attachment, created_at, updated_at, NULL as asset_name\n            ",
