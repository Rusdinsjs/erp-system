  "db_name": "PostgreSQL",
  "query": "\n            SELECT \n                ms.*,\n                a.name as asset_name\n            FROM maintenance_schedules ms\n            JOIN assets a ON ms.asset_id = a.id\n            WHERE ms.is_active = true \n              AND ms.interval_type = 'time'\n              AND ms.next_run_date <= $1\n            ",
