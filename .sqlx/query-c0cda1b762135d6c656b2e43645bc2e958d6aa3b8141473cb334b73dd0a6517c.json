  "query": "\n            SELECT \n                status,\n                COUNT(id) as count,\n                COALESCE(SUM(purchase_price), 0) as total_value\n            FROM assets\n            WHERE status != 'archived'\n            GROUP BY status\n            ORDER BY count DESC\n            ",
