  "query": "\n            UPDATE asset_tax_renewals\n            SET renewal_cost = $1, notes = COALESCE($2, notes), payment_destination = $3, invoice_attachment = $4, status = 'PENDING_APPROVAL', updated_at = NOW()\n            WHERE id = $5\n            RETURNING id, asset_id, document_type, current_expiry, renewal_cost, status, invoice_id, notes, payment_destination, invoice_attachment, created_at, updated_at, NULL as asset_name\n            ",
