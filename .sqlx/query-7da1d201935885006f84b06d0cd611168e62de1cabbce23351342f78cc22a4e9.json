{
  "db_name": "PostgreSQL",
  "query": "SELECT \n                a.name, a.asset_code, a.purchase_price, a.purchase_date,\n                d.accumulated_depreciation, d.book_value\n            FROM assets a\n            CROSS JOIN LATERAL (\n                SELECT accumulated_depreciation, book_value \n                FROM calculate_depreciation(a.id, CURRENT_DATE)\n            ) d\n            WHERE a.id = $1",
