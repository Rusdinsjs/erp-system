{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT \n                a.id as account_id,\n                a.code as account_code,\n                a.name as account_name,\n                a.account_type as \"account_type: AccountType\",\n                COALESCE(SUM(l.debit), 0)::FLOAT8 as \"total_debit!\",\n                COALESCE(SUM(l.credit), 0)::FLOAT8 as \"total_credit!\"\n            FROM chart_of_accounts a\n            LEFT JOIN journal_lines l ON a.id = l.account_id\n            GROUP BY a.id, a.code, a.name, a.account_type\n            ORDER BY a.code ASC\n            ",
  "describe": {
    "columns": [
      {
        "ordinal": 0,
        "name": "account_id",
        "type_info": "Uuid"
      },
      {
        "ordinal": 1,
        "name": "account_code",
        "type_info": "Varchar"
      },
      {
        "ordinal": 2,
        "name": "account_name",
        "type_info": "Varchar"
      },
      {
        "ordinal": 3,
        "name": "account_type: AccountType",
        "type_info": {
          "Custom": {
            "name": "account_type",
            "kind": {
              "Enum": [
                "asset",
                "liability",
                "equity",
                "revenue",
                "expense"
              ]
            }
          }
        }
      },
      {
        "ordinal": 4,
        "name": "total_debit!",
        "type_info": "Float8"
      },
      {
        "ordinal": 5,
        "name": "total_credit!",
        "type_info": "Float8"
      }
    ],
    "parameters": {
      "Left": []
    },
    "nullable": [
      false,
      false,
      false,
      false,
      null,
      null
    ]
  },
