  "db_name": "PostgreSQL",
  "query": "\n                    SELECT \n                        r.id, r.asset_id, r.document_type, r.current_expiry, r.renewal_cost, \n                        r.status, r.invoice_id, r.notes, r.payment_destination, r.invoice_attachment, r.created_at, r.updated_at,\n                        a.name as asset_name\n                    FROM asset_tax_renewals r\n                    LEFT JOIN assets a ON r.asset_id = a.id\n                    ORDER BY r.current_expiry ASC\n                    ",
