  "query": "\n                SELECT \n                    ri.*,\n                    a.name as asset_name,\n                    a.asset_code as asset_code\n                FROM rental_items ri\n                JOIN assets a ON ri.asset_id = a.id\n                WHERE ri.rental_id = $1\n                ORDER BY a.name\n                ",
