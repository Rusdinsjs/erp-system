[2m2026-01-26T17:08:46.686491Z[0m [34mDEBUG[0m [2msqlx::query[0m[2m:[0m [3msummary[0m[2m=[0m"-- Comprehesive Indonesian Chart …" [3mdb.statement[0m[2m=[0m"\n\n-- Comprehesive Indonesian Chart of Accounts (Kledo-style)\n-- Optimized for Asset Management and General Business\n-- Clear existing data (keeping it clean)\nTRUNCATE journal_lines CASCADE;\nTRUNCATE journal_entries CASCADE;\nTRUNCATE chart_of_accounts CASCADE;\n-- Helper UUIDs for Root Groups\n-- Asset: 1000-0000\n-- Liability: 2000-0000\n-- Equity: 3000-0000\n-- Revenue: 4000-0000\n-- COGS: 5000-0000\n-- Expense: 6000-0000\n-- Other Income: 8000-0000\n-- Other Expense: 9000-0000\n-- =========================================================\n-- 1. ASSETS (ASET)\n-- =========================================================\nINSERT INTO\n  chart_of_accounts (\n    id,\n    code,\n    name,\n    account_type,\n    normal_balance,\n    parent_id,\n    description\n  )\nVALUES\n  (\n    '00000000-0000-4001-a000-000000000000',\n    '1-0000',\n    'Aset',\n    'asset',\n    'debit',\n    NULL,\n    'Total Aset Perusahaan'\n  );\n-- 1.1 Aset Lancar\nINSERT INTO\n  chart_of_accounts (\n    id,\n    code,\n    name,\n    account_type,\n    normal_balance,\n    parent_id\n  )\nVALUES\n  (\n    '00000000-0000-4001-a100-000000000000',\n    '1-1000',\n    'Aset Lancar',\n    'asset',\n    'debit',\n    '00000000-0000-4001-a000-000000000000'\n  );\n-- 1.1.1 Kas & Bank\nINSERT INTO\n  chart_of_accounts (\n    id,\n    code,\n    name,\n    account_type,\n    normal_balance,\n    parent_id\n  )\nVALUES\n  (\n    '00000000-0000-4001-a110-000000000000',\n    '1-1100',\n    'Kas & Bank',\n    'asset',\n    'debit',\n    '00000000-0000-4001-a100-000000000000'\n  );\nINSERT INTO\n  chart_of_accounts (\n    id,\n    code,\n    name,\n    account_type,\n    normal_balance,\n    parent_id\n  )\nVALUES\n  (\n    '00000000-0000-4001-a111-000000000001',\n    '1-1110',\n    'Kas Tunai',\n    'asset',\n    'debit',\n    '