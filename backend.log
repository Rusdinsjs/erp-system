     'under_maintenance',\n            'under_repair',\n            'under_conversion',\n            'retired',\n            'disposed',\n            'planning',\n            'lost_stolen'\n          )\n        )\n      )\n    )\n  )\n  AND (\n    $8 :: boolean IS NULL\n    OR a.is_fuel = $8\n  )\n  AND (\n    $10 :: text IS NULL\n    OR c.asset_group = $10\n  )\nORDER BY\n  a.created_at DESC\nLIMIT\n  $6 OFFSET $7\n" [3mrows_affected[0m[2m=[0m15 [3mrows_returned[0m[2m=[0m15 [3melapsed[0m[2m=[0m19.140575ms [3melapsed_secs[0m[2m=[0m0.019140575
